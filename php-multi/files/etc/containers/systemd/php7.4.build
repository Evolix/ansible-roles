[Build]
ImageTag=localhost/php/7.4:latest
File=/etc/evolinux/containers/php/Containerfile.in

# Because we want to control the image lifecycle manually and we want a
# consistent behaviour when starting this service, we never want it to pull
# an image.
Pull=never

PodmanArgs=--cpp-flag=-DPHP_VERSION=74

SetWorkingDirectory=/var/lib/evolinux/containers/
