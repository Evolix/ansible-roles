upstream forgejo_{{ forgejo_instance }} {
    server unix:/run/forgejo/{{ forgejo_instance }}/forgejo.sock;
}

server {
  listen 80;
  listen [::]:80;
  server_name {{ forgejo_domains | first }};
  
  # For certbot
  include /etc/nginx/snippets/letsencrypt.conf;
 
  {% if ssl.stat.exists %}
  location / { return 301 https://$host$request_uri; }
  {% endif %}
}

{% if ssl.stat.exists %}
server {
    listen 0.0.0.0:443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{ forgejo_domains | first }};
    
    access_log /var/log/nginx/{{ forgejo_instance }}.access.log;
    error_log  /var/log/nginx/{{ forgejo_instance }}.error.log;

    include /etc/nginx/snippets/letsencrypt.conf;
    ssl_certificate     /etc/letsencrypt/live/{{ forgejo_instance }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ forgejo_instance }}/privkey.pem;

    # HSTS (ngx_http_headers_module is required) (15768000 seconds = 6 months)
    add_header Strict-Transport-Security max-age=15768000;

    # OCSP Stapling 
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ forgejo_instance }}/fullchain.pem;
    resolver 31.170.11.254;

    location / {
        proxy_pass http://forgejo_{{ forgejo_instance }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10;
    }
}
{% endif %}
