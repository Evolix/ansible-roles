[Unit]
Description=mastodon-web
After=network.target
PartOf={{ mastodon_instance }}.target

[Service]
Type=simple
User={{ mastodon_instance }}
Group={{ mastodon_instance }}
UMask=0027
WorkingDirectory=/{{ mastodon_home_base }}/{{ mastodon_instance }}/mastodon/
Environment="WEB_CONCURRENCY={{ mastodon_puma_web_concurrence }}"
Environment="RAILS_ENV=production"
Environment="PORT={{ mastodon_puma_port | default('3000') }}"
Environment="RAILS_LOG_LEVEL=warn"
Environment="LD_PRELOAD=libjemalloc.so"
ExecStart=/{{ mastodon_home_base }}/{{ mastodon_instance }}/.rbenv/shims/bundle exec puma -C config/puma.rb
ExecReload=/bin/kill -SIGUSR1 $MAINPID
TimeoutSec=15
Restart=always
SyslogIdentifier=%p

[Install]
WantedBy={{ mastodon_instance }}.target
