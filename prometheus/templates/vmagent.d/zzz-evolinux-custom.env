# Fichier de configuration pour vmagent contenant la configuration
# spécifique à ce systême. Ce fichier est au format EnvironmentFile de
# systemd.exec(5). Les variables d'envrionement utilisées par vmagent
# correspondents aux arguments de vmagent mais où le caractère . est
# remplacé par _.
 
# remoteWrite_url=http://exemple.com:8428/api/v1/write
# remoteWrite_tlsCAFile=/etc/victoria-metrics/ssl/ca.crt
# remoteWrite_tlsCertFile=/etc/victoria-metrics/ssl/foo.exemple.com.crt
# remoteWrite_tlsKeyFile=/etc/victoria-metrics/ssl/foo.exemple.com.key
