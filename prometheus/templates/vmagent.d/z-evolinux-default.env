# Fichier de configuration pour vmagent contenant la configuration par
# defaut d'Evolix. Ce fichier est au format EnvironmentFile de
# systemd.exec(5). Les variables d'envrionement utilisées par vmagent
# correspondents aux arguments de vmagent mais où le caractère . est
# remplacé par _.
 
remoteWrite_tmpDataPath=/var/cache/vmagent
promscrape_config=/etc/victoria-metrics/scrape.yml
httpListenAddr=127.0.0.1:8429
